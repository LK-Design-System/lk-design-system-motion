{
  "name": "@lk-design-system/lds-motion",
  "version": "0.1.0-alpha.3",
  "description": "Deterministic motion layer for LDS — renders design-system slide layouts to video. Self-contained engine, no per-seat licensing.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "render": "node scripts/render.mjs",
    "check:determinism": "node scripts/check-determinism.mjs",
    "check:types": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@lk-design-system/lds-core": "file:vendor/lk-design-system-lds-core-0.1.0-rc.4.tgz",
    "@lk-design-system/lds-slides-ui": "file:vendor/lk-design-system-lds-slides-ui-0.1.0-alpha.3.tgz",
    "@lk-design-system/lds-theme": "file:vendor/lk-design-system-lds-theme-0.1.0-rc.4.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@lk-design-system/lds-product": "file:vendor/lk-design-system-lds-product-0.1.0-rc.4.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true,
    "playwright@1.61.1": true
  }
}
